PORT=3000
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Firebase project id (required)
FIREBASE_PROJECT_ID=node-demo-5f575
# For real Firebase: path to a service-account JSON key
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# For local development with the Firestore emulator instead:
FIRESTORE_EMULATOR_HOST=localhost:8080
